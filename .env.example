# Local development only. Replace before starting PostgreSQL.
POSTGRES_PASSWORD=replace-with-your-local-password

# Enable only for local API/DB integration; no authorisation is implemented yet.
ENABLE_QUIZ_API=false
# Replace the password in both variables; URL-encode special password characters.
DATABASE_URL=postgresql://quiz_local:replace-with-your-local-password@127.0.0.1:5432/quiz_local?schema=public
PORT=3000
